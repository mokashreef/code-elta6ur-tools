# ============================================
# Code Elta6ur Tools - Environment Configuration
# ============================================

# Database Configuration (Optional for local development; SQLite will be used automatically if MySQL is not available)
DB_HOST=localhost
DB_NAME=elta6ur_tools
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Deployment Credentials (Optional - used by deployment scripts)
DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=your-ssh-user
DEPLOY_PASS=
