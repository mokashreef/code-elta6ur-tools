# ============================================
# Git Ignore - Code Elta6ur Tools Platform
# ============================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Local SQLite databases & binary dumps
database/*.sqlite
database/*.sqlite3
database/*.db
*.sqlite
*.sqlite3
*.db

# Temporary deployment packages & backups
*.tar.gz
*.zip
*.tar
backup_*.tar.gz
deploy_package.tar.gz

# Deployment scratch & execution scripts with credentials
scripts/test_ssh_conn.py
scripts/remote_exec.py

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sublime-workspace
*.sublime-project

# Temporary cache & uploads
tmp/
cache/
temp/
